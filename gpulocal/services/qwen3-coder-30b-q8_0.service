[Unit]
Description=Qwen3-Coder-30B-A3B (Q8_0) — llama.cpp server (编程主模型, 双卡)
Documentation=https://github.com/ggerganov/llama.cpp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 编程主模型 Q8_0(8位量化, 30B MoE 仅3B激活)，纯文本无 mmproj，双卡按层拆分
ExecStart=%h/llama.cpp-dflash2/build/bin/llama-server \
    -m %h/models/Qwen3-Coder-30B-A3B-GGUF/Qwen3-Coder-30B-A3B-Instruct-Q8_0.gguf \
    --host 127.0.0.1 --port 8082 \
    --split-mode layer --n-gpu-layers 99 \
    --flash-attn on --cache-type-k q8_0 --cache-type-v q8_0 \
    --ctx-size 16384 --parallel 1 \
    --alias qwen3-coder-30b-q8_0
Restart=on-failure
RestartSec=5
TimeoutStartSec=600

[Install]
WantedBy=default.target
